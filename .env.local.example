# Adresse qui reçoit les emails "Contacter le webmaster" (src/app/espace/actions.ts). Le
# compte admin lui-même (connexion sur /admin) est un vrai utilisateur Supabase Auth, avec une
# ligne dans `admin_users` (supabase/migrations/0016_admin_role.sql) : identifiants gérés
# depuis Supabase, pas via une variable d'environnement comparée dans le code.
ZOODOMO_ADMIN_EMAIL=mon-email@nomdomaine.com
ZOODOMO_ADMIN_PASSWORD=change-me

# Prix de l'abonnement (en euros, nombre seul, pas de symbole ni de texte), publics
# (affichés sur les pages de connexion/inscription), d'où le préfixe NEXT_PUBLIC_
NEXT_PUBLIC_ZOODOMO_PRICE_MONTHLY=19
NEXT_PUBLIC_ZOODOMO_PRICE_ANNUAL=190

# Mettre à `false` pour désactiver temporairement la création de nouveaux comptes (ex. :
# site mis en ligne pour tester la réception d'emails réels, sans vouloir de vraies
# inscriptions pendant ce temps). Absente ou toute autre valeur = inscriptions ouvertes.
ZOODOMO_SIGNUPS_ENABLED=true

# Supabase (Project Settings > API dans le dashboard). Les deux premières sont publiques
# (préfixe NEXT_PUBLIC_), protégées côté serveur par les règles RLS. La clé service_role
# contourne RLS : jamais de préfixe NEXT_PUBLIC_, jamais envoyée au navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me

# Resend : uniquement pour les emails applicatifs envoyés directement par l'app (nouveau
# message reçu, rappels d'essai/de fiche). Les emails d'authentification (confirmation,
# réinitialisation) restent gérés par Supabase Auth seul, via son propre réglage SMTP
# (dashboard Supabase, Authentication > Settings > SMTP Settings), sans lien avec ces
# variables.
RESEND_API_KEY=change-me
RESEND_FROM_EMAIL=noreply@nomdomaine.com

# Cloudflare Turnstile (CAPTCHA sur inscription/mot de passe oublié). Site key uniquement :
# publique, sans risque à exposer côté client. La secret key ne vit jamais ici ni dans le
# code, elle est configurée directement dans Supabase (Authentication > Settings > CAPTCHA
# protection), qui vérifie les jetons lui-même.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=change-me

# Paddle (Merchant of Record, abonnement 19€/mois ou 190€/an, voir docs/DECISIONS.md).
# Clé API server-side (Paddle > Developer tools > Authentication) : `pdl_sdbx_...` en
# sandbox, `pdl_live_...` en production, jamais la même clé pour les deux environnements.
PADDLE_API_KEY=change-me

# Catalogue Paddle (produit + prix), créé une fois via scripts/seed-paddle-catalog.ts.
# Id de prix publics (utilisés côté client par Paddle.js au checkout).
PADDLE_PRODUCT_ID=change-me
NEXT_PUBLIC_PADDLE_PRICE_ID_MONTHLY=change-me
NEXT_PUBLIC_PADDLE_PRICE_ID_ANNUAL=change-me

# Jeton côté client (Developer tools > Authentication > Jetons côté client), différent de
# PADDLE_API_KEY : sert au checkout dans le navigateur, sans risque à exposer.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=change-me
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Secret de la destination de notification (webhook), Developer tools > Notifications.
PADDLE_NOTIFICATION_WEBHOOK_SECRET=change-me
