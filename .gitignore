# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Zoodomo : dossiers de travail exclus du repo (section 7 du brief)
/docs/
/passwords/
/resources/

# Fichiers d'instructions agents IA : gardés à la racine (requis pour l'auto-chargement),
# mais jamais commités
AGENTS.md
CLAUDE.md

# Compétences d'agent installées via `npx skills add` (ex: Paddle, 2026-08-24), même
# principe que ci-dessus : instructions pour l'agent IA, pas du code du produit.
/.agents/
/.claude/skills/
/skills-lock.json

# Sentry Config File
.env.sentry-build-plugin

# Cache local du CLI Supabase (créé par `npx supabase ...`, ex. `projects list`), aucun
# contenu utile (juste un marqueur de version), rien à committer.
/supabase/.temp/
